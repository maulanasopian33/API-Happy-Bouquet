PORT=5000
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=happybouquet_dev
DB_HOST=127.0.0.1
JWT_SECRET=your_jwt_secret_here

# Redis Configuration (For Realtime Visitor Analytics)
REDIS_URL=redis://localhost:6379/1

# Upstash Redis Configuration (Optional - for HTTP-based Redis)
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your_token

# Upstash REST API (dipakai fitur /api/cache untuk mengelola cache Nuxt)
# Isi dengan kredensial Upstash yang sama seperti di repo storefront.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32-character key for encryption
ENCRYPTION_KEY=your_32_character_secret_key_here

# CORS allowed origins (comma-separated, production only)
# Example: https://happybouquet.com,https://admin.happybouquet.com
CORS_ORIGINS=

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-business/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/business.manage

# Gemini AI (integrasi /api/ai)
# Dapatkan API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
